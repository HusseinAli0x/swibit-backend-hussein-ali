# --- Postgres container settings (used by the `db` service in docker-compose.yml) ---
POSTGRES_USER=swibit
POSTGRES_PASSWORD=swibit
POSTGRES_DB=swibit
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- App settings (read by app/core/config.py) ---
# Full connection string the API uses to reach Postgres.
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg2://swibit:swibit@db:5432/swibit

# JWT signing key. Generate a real random value for real use, e.g.:
#   openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Where the background export worker writes JSON export files (inside the container).
EXPORT_DIR=/app/exports
